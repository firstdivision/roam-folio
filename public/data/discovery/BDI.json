{"facts":[{"text":"Gitega is the capital of Burundi.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — pinned country reference"},{"text":"Burundi is in Africa.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — pinned country reference"},{"text":"Burundi is landlocked.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — pinned country reference"}],"culture":{"text":"Craft traditions include wood carving and landscape painting in Gitega and Bujumbura.","sourceUrl":"https://en.wikivoyage.org/wiki/Burundi","sourceTitle":"Burundi — Wikivoyage"},"food":{"name":"Beef brochettes","text":"Grilled beef skewers are commonly paired with grilled plantains.","sourceUrl":"https://en.wikivoyage.org/wiki/Burundi#Eat","sourceTitle":"Burundi — Wikivoyage — Eat"},"photo":{"src":"data/postcards/BDI.c6dd72932593.jpg","alt":"The road between Gitega and Bujumbura, Burundi","width":960,"height":767,"author":"Dave Proffer","sourceTitle":"Road between Burundi Gitega and Bujumbura - Flickr - Dave Proffer (4).jpg","sourceUrl":"https://commons.wikimedia.org/wiki/File:Road_between_Burundi_Gitega_and_Bujumbura_-_Flickr_-_Dave_Proffer_(4).jpg","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0","changes":"Resized."}}
