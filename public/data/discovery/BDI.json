{"facts":[{"text":"Gitega is the capital of Burundi.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — pinned country reference"},{"text":"Burundi is in Africa.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — pinned country reference"},{"text":"Burundi is landlocked.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — pinned country reference"}],"culture":{"text":"Craft traditions include wood carving and landscape painting in Gitega and Bujumbura.","sourceUrl":"https://en.wikivoyage.org/wiki/Burundi","sourceTitle":"Burundi — Wikivoyage"},"food":{"name":"Beef brochettes","text":"Grilled beef skewers are commonly paired with grilled plantains.","sourceUrl":"https://en.wikivoyage.org/wiki/Burundi#Eat","sourceTitle":"Burundi — Wikivoyage — Eat"}}
