{"facts":[{"text":"Sarajevo is the capital.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — country reference"},{"text":"Languages spoken here include Bosnian, Croatian and Serbian.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — country reference"},{"text":"It is a coastal country in Southeast Europe.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — country reference"}],"culture":{"text":"Bosnian coffee is an established local tradition, with a preparation reminiscent of Turkish coffee.","sourceUrl":"https://en.wikivoyage.org/wiki/Bosnia_and_Herzegovina","sourceTitle":"Wikivoyage — Bosnia and Herzegovina"},"food":{"name":"Ćevapi","text":"Small grilled kebabs, with distinct regional styles associated with Sarajevo and Banja Luka.","sourceUrl":"https://en.wikivoyage.org/wiki/Bosnia_and_Herzegovina#Eat","sourceTitle":"Wikivoyage — Bosnia and Herzegovina — Eat"},"photo":{"src":"data/postcards/BIH.8a7b5b421df3.jpg","alt":"Travnik panorama, Bosnia and Herzegovina","width":960,"height":640,"author":"Julian Nyča","sourceTitle":"Travnik Panorama 1.JPG","sourceUrl":"https://commons.wikimedia.org/wiki/File:Travnik_Panorama_1.JPG","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","changes":"Resized."}}
