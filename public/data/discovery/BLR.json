{"facts":[{"text":"Minsk is the capital.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — country reference"},{"text":"Languages spoken here include Belarusian and Russian.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — country reference"},{"text":"It is a landlocked country in Eastern Europe.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — country reference"}],"culture":{"text":"Belarusian straw weavers make baskets, hats, toys and symbolic decorations, passing skills through families and craft communities.","sourceUrl":"https://ich.unesco.org/en/RL/straw-weaving-in-belarus-art-craft-and-skills-01889?RL=01889","sourceTitle":"UNESCO — Straw weaving in Belarus, art, craft and skills"},"food":{"name":"Draniki","text":"Potato pancakes are a familiar dish to discover in Belarusian cooking.","sourceUrl":"https://en.wikivoyage.org/wiki/Belarus#Eat","sourceTitle":"Wikivoyage — Belarus — Eat"},"photo":{"src":"data/postcards/BLR.187918406815.jpg","alt":"Independence Square in Minsk, Belarus","width":960,"height":540,"author":"Zedlik","sourceTitle":"Miensk - Plac Niezaležnaści.jpg","sourceUrl":"https://commons.wikimedia.org/wiki/File:Miensk_-_Plac_Niezale%C5%BEna%C5%9Bci.jpg","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","changes":"Resized."}}
