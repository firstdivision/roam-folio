{"facts":[{"text":"Yaoundé is the capital.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — country reference"},{"text":"Languages spoken here include English and French.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — country reference"},{"text":"It is a coastal country in Middle Africa.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — country reference"}],"culture":{"text":"Douala's craft markets offer an introduction to Cameroonian handicrafts.","sourceUrl":"https://en.wikivoyage.org/wiki/Cameroon","sourceTitle":"Wikivoyage — Cameroon"},"food":{"name":"Ndolé","text":"Bitter greens and peanuts form the basis of a dish that may also include fish, prawns or beef.","sourceUrl":"https://en.wikivoyage.org/wiki/Cameroon#Eat","sourceTitle":"Wikivoyage — Cameroon — Eat"}}
