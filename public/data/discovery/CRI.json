{"facts":[{"text":"San José is the capital.","sourceUrl":"https://en.wikivoyage.org/wiki/Costa_Rica","sourceTitle":"Costa Rica — Wikivoyage"},{"text":"Costa Rica has both Caribbean and Pacific coasts.","sourceUrl":"https://en.wikivoyage.org/wiki/Costa_Rica","sourceTitle":"Costa Rica — Wikivoyage"},{"text":"Its landscapes include rainforests, volcanoes, and high mountains.","sourceUrl":"https://en.wikivoyage.org/wiki/Costa_Rica","sourceTitle":"Costa Rica — Wikivoyage"}],"culture":{"text":"Along the Caribbean coast, Limonese Creole reflects connections with other English-speaking Caribbean communities.","sourceUrl":"https://en.wikivoyage.org/wiki/Costa_Rica","sourceTitle":"Costa Rica — Wikivoyage"},"food":{"name":"Gallo pinto","text":"Rice and beans are cooked together, often with onion or cilantro, and commonly served at breakfast.","sourceUrl":"https://en.wikivoyage.org/wiki/Costa_Rica","sourceTitle":"Costa Rica — Wikivoyage"},"photo":{"src":"data/postcards/CRI.e5534dceb212.jpg","alt":"Cartago, Costa Rica","width":960,"height":553,"author":"belemita@gmail.com","sourceTitle":"Cartago, costa rica - panoramio.jpg","sourceUrl":"https://commons.wikimedia.org/wiki/File:Cartago,_costa_rica_-_panoramio.jpg","license":"CC BY 3.0","licenseUrl":"https://creativecommons.org/licenses/by/3.0","changes":"Resized."}}
