{"facts":[{"text":"Nicosia is the capital.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — country reference"},{"text":"Languages spoken here include Greek and Turkish.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — country reference"},{"text":"The country has a coastline.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — country reference"}],"culture":{"text":"The village of Lefkara is known for its intricate lacework.","sourceUrl":"https://en.wikivoyage.org/wiki/Cyprus","sourceTitle":"Wikivoyage — Cyprus"},"food":{"name":"Halloumi","text":"This salty Cypriot cheese, also called hellim, is often served grilled.","sourceUrl":"https://en.wikivoyage.org/wiki/Cyprus#Eat","sourceTitle":"Wikivoyage — Cyprus — Eat"},"photo":{"src":"data/postcards/CYP.f44aaba85c39.jpg","alt":"Landscape near Trodos, Cyprus","width":960,"height":720,"author":"Michal Osmenda from Brussels, Belgium","sourceTitle":"Near Trodos, Cyprus (8132780501).jpg","sourceUrl":"https://commons.wikimedia.org/wiki/File:Near_Trodos,_Cyprus_(8132780501).jpg","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0","changes":"Resized."}}
