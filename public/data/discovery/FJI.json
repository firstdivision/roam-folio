{"facts":[{"text":"Fiji is a Pacific archipelago.","sourceUrl":"https://en.wikivoyage.org/wiki/Fiji","sourceTitle":"Fiji — Wikivoyage"},{"text":"Viti Levu and Vanua Levu are its largest islands.","sourceUrl":"https://en.wikivoyage.org/wiki/Fiji","sourceTitle":"Fiji — Wikivoyage"},{"text":"Suva is the capital.","sourceUrl":"https://en.wikivoyage.org/wiki/Fiji","sourceTitle":"Fiji — Wikivoyage"}],"culture":{"text":"Yaqona, also called kava, has a ceremonial role in village visits and hospitality.","sourceUrl":"https://en.wikivoyage.org/wiki/Fiji","sourceTitle":"Fiji — Wikivoyage"},"food":{"name":"Kokoda","text":"Fish or other seafood is marinated with citrus and coconut milk.","sourceUrl":"https://en.wikivoyage.org/wiki/Fiji","sourceTitle":"Fiji — Wikivoyage"},"photo":{"src":"data/postcards/FJI.5e20737885d6.jpg","alt":"Denarau Island, Fiji","width":960,"height":610,"author":"Fijiisparadise","sourceTitle":"Denarau Island in Fiji, 2013.jpg","sourceUrl":"https://commons.wikimedia.org/wiki/File:Denarau_Island_in_Fiji,_2013.jpg","license":"CC BY 3.0","licenseUrl":"https://creativecommons.org/licenses/by/3.0","changes":"Resized."}}
