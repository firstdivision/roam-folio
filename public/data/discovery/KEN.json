{"facts":[{"text":"Nairobi is the capital.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — country reference"},{"text":"Languages spoken here include English and Swahili.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — country reference"},{"text":"It is a coastal country in Eastern Africa.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — country reference"}],"culture":{"text":"Tea and coffee are part of Kenyan social life; Kenyan tea is commonly prepared strong and sweet.","sourceUrl":"https://en.wikivoyage.org/wiki/Kenya","sourceTitle":"Wikivoyage — Kenya"},"food":{"name":"Ugali","text":"A firm maize porridge is served alongside stews or sauces with vegetables, beans or meat.","sourceUrl":"https://en.wikivoyage.org/wiki/Kenya#Eat","sourceTitle":"Wikivoyage — Kenya — Eat"},"photo":{"src":"data/postcards/KEN.133d972bfcdf.jpg","alt":"Mount Kenya landscape","width":960,"height":720,"author":"saragoldsmith","sourceTitle":"Mt Kenya landscape.jpg","sourceUrl":"https://commons.wikimedia.org/wiki/File:Mt_Kenya_landscape.jpg","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0","changes":"Resized."}}
