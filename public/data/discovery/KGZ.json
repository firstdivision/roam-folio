{"facts":[{"text":"Bishkek is the capital of Kyrgyzstan.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — pinned country reference"},{"text":"Kyrgyzstan is in Asia.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — pinned country reference"},{"text":"Kyrgyzstan is landlocked.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — pinned country reference"}],"culture":{"text":"Kyrgyz cooking reflects a history of pastoral nomadism and communal meals.","sourceUrl":"https://en.wikivoyage.org/wiki/Kyrgyzstan","sourceTitle":"Kyrgyzstan — Wikivoyage"},"food":{"name":"Besh barmak","text":"Boiled meat is combined with noodles and sometimes onions, traditionally served from a shared dish.","sourceUrl":"https://en.wikivoyage.org/wiki/Kyrgyzstan#Eat","sourceTitle":"Kyrgyzstan — Wikivoyage — Eat"},"photo":{"src":"data/postcards/KGZ.f8633183b258.jpg","alt":"Tash Rabat, Kyrgyzstan","width":960,"height":720,"author":"Laurent de Walick","sourceTitle":"Landscape near Tash Rabat Kyrgyzstan.jpg","sourceUrl":"https://commons.wikimedia.org/wiki/File:Landscape_near_Tash_Rabat_Kyrgyzstan.jpg","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0","changes":"Resized."}}
