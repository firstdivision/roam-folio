{"facts":[{"text":"Rabat is the capital.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — country reference"},{"text":"Languages spoken here include Arabic and Berber.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — country reference"},{"text":"It is a coastal country in Northern Africa.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — country reference"}],"culture":{"text":"Serving mint green tea is a familiar gesture of hospitality in Morocco.","sourceUrl":"https://en.wikivoyage.org/wiki/Morocco","sourceTitle":"Wikivoyage — Morocco"},"food":{"name":"Tagine","text":"A slowly cooked dish named for its clay vessel, with combinations such as chicken and preserved lemon.","sourceUrl":"https://en.wikivoyage.org/wiki/Morocco#Eat","sourceTitle":"Wikivoyage — Morocco — Eat"},"photo":{"src":"data/postcards/MAR.c8e6413cb0e1.jpg","alt":"Chefchaouen, Morocco","width":960,"height":717,"author":"YoTuT from United States","sourceTitle":"Chefchaouen, Morocco (5409528959) (3).jpg","sourceUrl":"https://commons.wikimedia.org/wiki/File:Chefchaouen,_Morocco_(5409528959)_(3).jpg","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0","changes":"Resized."}}
