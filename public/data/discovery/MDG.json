{"facts":[{"text":"Antananarivo is the capital.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — country reference"},{"text":"Languages spoken here include Malagasy and French.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — country reference"},{"text":"It is a coastal country in Eastern Africa.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — country reference"}],"culture":{"text":"A hotely is a local eatery where rice and its accompaniments are served as an everyday meal.","sourceUrl":"https://en.wikivoyage.org/wiki/Madagascar","sourceTitle":"Wikivoyage — Madagascar"},"food":{"name":"Rice with laoka","text":"Rice is paired with laoka, a side dish such as beans, chicken or pork.","sourceUrl":"https://en.wikivoyage.org/wiki/Madagascar#Eat","sourceTitle":"Wikivoyage — Madagascar — Eat"}}
