{"facts":[{"text":"Windhoek is the capital.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — country reference"},{"text":"Languages spoken here include Ndonga, English and Afrikaans.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — country reference"},{"text":"It is a coastal country in Southern Africa.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — country reference"}],"culture":{"text":"A braai is both a wood-fired barbecue and an occasion for people to socialise.","sourceUrl":"https://en.wikivoyage.org/wiki/Namibia","sourceTitle":"Wikivoyage — Namibia"},"food":{"name":"Kingklip","text":"This fish is one of the seafood specialities available in Namibia's coastal towns.","sourceUrl":"https://en.wikivoyage.org/wiki/Namibia#Eat","sourceTitle":"Wikivoyage — Namibia — Eat"},"photo":{"src":"data/postcards/NAM.67342af1a7b4.jpg","alt":"A seal colony on the Skeleton Coast, Namibia","width":960,"height":726,"author":"Anagoria","sourceTitle":"Robbenkolonie Sklelettküste anagoria.JPG","sourceUrl":"https://commons.wikimedia.org/wiki/File:Robbenkolonie_Sklelettk%C3%BCste_anagoria.JPG","license":"CC BY 3.0","licenseUrl":"https://creativecommons.org/licenses/by/3.0","changes":"Resized."}}
