{"facts":[{"text":"Managua is the capital.","sourceUrl":"https://en.wikivoyage.org/wiki/Nicaragua","sourceTitle":"Nicaragua — Wikivoyage"},{"text":"Lake Nicaragua is also called Cocibolca.","sourceUrl":"https://en.wikivoyage.org/wiki/Nicaragua","sourceTitle":"Nicaragua — Wikivoyage"},{"text":"The volcanic island of Ometepe rises from Lake Nicaragua.","sourceUrl":"https://en.wikivoyage.org/wiki/Nicaragua","sourceTitle":"Nicaragua — Wikivoyage"}],"culture":{"text":"Creole English and Indigenous languages are part of the cultural life of Nicaragua’s Caribbean region.","sourceUrl":"https://en.wikivoyage.org/wiki/Nicaragua","sourceTitle":"Nicaragua — Wikivoyage"},"food":{"name":"Nacatamales","text":"These large, savory tamales are wrapped in banana leaves and often eaten on Sundays.","sourceUrl":"https://en.wikivoyage.org/wiki/Nicaragua","sourceTitle":"Nicaragua — Wikivoyage"},"photo":{"src":"data/postcards/NIC.20e74c7bf0b3.jpg","alt":"View of Cerro Kilambè, Nicaragua","width":960,"height":720,"author":"Jersan27","sourceTitle":"Cerro Kilambè.JPG","sourceUrl":"https://commons.wikimedia.org/wiki/File:Cerro_Kilamb%C3%A8.JPG","license":"CC BY-SA 3.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0","changes":"Resized."}}
