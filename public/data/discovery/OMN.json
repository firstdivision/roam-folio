{"facts":[{"text":"Oman lies on the eastern Arabian Peninsula.","sourceUrl":"https://en.wikivoyage.org/wiki/Oman","sourceTitle":"Oman — Wikivoyage"},{"text":"Muscat is the capital.","sourceUrl":"https://en.wikivoyage.org/wiki/Oman","sourceTitle":"Oman — Wikivoyage"},{"text":"The southern city of Salalah has a seasonal monsoon climate.","sourceUrl":"https://en.wikivoyage.org/wiki/Oman","sourceTitle":"Oman — Wikivoyage"}],"culture":{"text":"Craftspeople in Sur continue the tradition of building wooden dhows.","sourceUrl":"https://en.wikivoyage.org/wiki/Oman","sourceTitle":"Oman — Wikivoyage"},"food":{"name":"Shuwa","text":"Spiced lamb wrapped in leaves is traditionally cooked slowly in an underground oven.","sourceUrl":"https://en.wikivoyage.org/wiki/Oman","sourceTitle":"Oman — Wikivoyage"},"photo":{"src":"data/postcards/OMN.49ce689a5d8f.jpg","alt":"The Land of Frankincense, Oman","width":960,"height":720,"author":"Giovanni Boccardi","sourceTitle":"Land of Frankincense-118844.jpg","sourceUrl":"https://commons.wikimedia.org/wiki/File:Land_of_Frankincense-118844.jpg","license":"CC BY-SA 3.0 igo","licenseUrl":"https://creativecommons.org/licenses/by-sa/3.0/igo/deed.en","changes":"Resized."}}
