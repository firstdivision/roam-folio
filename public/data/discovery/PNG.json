{"facts":[{"text":"Port Moresby is the capital.","sourceUrl":"https://en.wikivoyage.org/wiki/Papua_New_Guinea","sourceTitle":"Papua New Guinea — Wikivoyage"},{"text":"The country includes eastern New Guinea and many offshore islands.","sourceUrl":"https://en.wikivoyage.org/wiki/Papua_New_Guinea","sourceTitle":"Papua New Guinea — Wikivoyage"},{"text":"The New Guinea Highlands form a mountainous interior.","sourceUrl":"https://en.wikivoyage.org/wiki/Papua_New_Guinea","sourceTitle":"Papua New Guinea — Wikivoyage"}],"culture":{"text":"Sing-sing performances at events such as the Goroka Show bring different cultural ensembles together.","sourceUrl":"https://en.wikivoyage.org/wiki/Papua_New_Guinea","sourceTitle":"Papua New Guinea — Wikivoyage"},"food":{"name":"Mumu","text":"An earth oven slowly cooks meat and vegetables such as kaukau, or sweet potato.","sourceUrl":"https://en.wikivoyage.org/wiki/Papua_New_Guinea","sourceTitle":"Papua New Guinea — Wikivoyage"},"photo":{"src":"data/postcards/PNG.f14d3059d20e.jpg","alt":"Mt Giluwe, Papua New Guinea","width":960,"height":640,"author":"Kaijankoski","sourceTitle":"Mount Giluwe.jpg","sourceUrl":"https://commons.wikimedia.org/wiki/File:Mount_Giluwe.jpg","license":"CC0","licenseUrl":"https://creativecommons.org/publicdomain/zero/1.0/deed.en","changes":"Resized."}}
