{"facts":[{"text":"Khartoum is the capital.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — country reference"},{"text":"Languages spoken here include Arabic and English.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — country reference"},{"text":"It is a coastal country in Northern Africa.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — country reference"}],"culture":{"text":"Meroe's pyramids, temples and settlements preserve the cultural legacy of the ancient Kingdom of Kush.","sourceUrl":"https://whc.unesco.org/en/list/1336/","sourceTitle":"UNESCO — Archaeological Sites of the Island of Meroe"},"food":{"name":"Gurassa bil damaa","text":"A thick wheat flatbread is topped with a meat or chicken stew.","sourceUrl":"https://en.wikivoyage.org/wiki/Sudan#Eat","sourceTitle":"Wikivoyage — Sudan — Eat"},"photo":{"src":"data/postcards/SDN.3f77fdd125ac.jpg","alt":"The pyramids of Meroë, Sudan","width":960,"height":561,"author":"Fabrizio Demartis","sourceTitle":"Sudan Meroe Pyramids 30sep2005 2.jpg","sourceUrl":"https://commons.wikimedia.org/wiki/File:Sudan_Meroe_Pyramids_30sep2005_2.jpg","license":"CC BY-SA 2.0","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.0","changes":"Resized."}}
