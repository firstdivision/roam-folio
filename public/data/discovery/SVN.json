{"facts":[{"text":"Ljubljana is the capital.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — country reference"},{"text":"Slovene is spoken here.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — country reference"},{"text":"It is a coastal country in Central Europe.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — country reference"}],"culture":{"text":"Rural inns called gostilna or gostišče are traditional places to find hearty Slovenian cooking.","sourceUrl":"https://en.wikivoyage.org/wiki/Slovenia","sourceTitle":"Wikivoyage — Slovenia"},"food":{"name":"Potica","text":"A rolled cake, often filled with nuts, prepared for holidays in many variations.","sourceUrl":"https://en.wikivoyage.org/wiki/Slovenia#Eat","sourceTitle":"Wikivoyage — Slovenia — Eat"},"photo":{"src":"data/postcards/SVN.c57921864f62.jpg","alt":"Predjama Castle in Karst, Slovenia","width":960,"height":640,"author":"Nicolas Vollmer from Munich [Allemagne]","sourceTitle":"Slovénie - Château de Predjama (14748808300).jpg","sourceUrl":"https://commons.wikimedia.org/wiki/File:Slov%C3%A9nie_-_Ch%C3%A2teau_de_Predjama_(14748808300).jpg","license":"CC BY 2.0","licenseUrl":"https://creativecommons.org/licenses/by/2.0","changes":"Resized."}}
