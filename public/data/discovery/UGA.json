{"facts":[{"text":"Kampala is the capital.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — country reference"},{"text":"Languages spoken here include English and Swahili.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — country reference"},{"text":"It is a landlocked country in Eastern Africa.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — country reference"}],"culture":{"text":"Baganda artisans make barkcloth by beating the inner bark of the mutuba tree into a soft textile.","sourceUrl":"https://ich.unesco.org/en/RL/barkcloth-making-in-uganda-00139","sourceTitle":"UNESCO — Barkcloth making in Uganda"},"food":{"name":"Luwombo","text":"Meat or groundnut sauce is steamed inside banana leaves, which give the dish its distinctive aroma.","sourceUrl":"https://en.wikivoyage.org/wiki/Uganda#Eat","sourceTitle":"Wikivoyage — Uganda — Eat"},"photo":{"src":"data/postcards/UGA.b83e28a9ba80.jpg","alt":"Lake Bunyonyi, Uganda","width":800,"height":533,"author":"User:Edirisa","sourceTitle":"Lake Bunyonyi.jpg","sourceUrl":"https://commons.wikimedia.org/wiki/File:Lake_Bunyonyi.jpg","license":"CC BY-SA 2.5","licenseUrl":"https://creativecommons.org/licenses/by-sa/2.5","changes":"Unmodified."}}
