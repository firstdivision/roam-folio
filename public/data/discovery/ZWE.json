{"facts":[{"text":"Harare is the capital.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — country reference"},{"text":"Languages spoken here include Shona, Ndebele and English.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — country reference"},{"text":"It is a landlocked country in Eastern Africa.","sourceUrl":"https://github.com/mledoze/countries/blob/6031f5df137c41c76d180c55a0782185ae3ed05b/countries.json","sourceTitle":"mledoze/countries — country reference"}],"culture":{"text":"The mbira is central to Shona musical traditions, often played with hosho rattles in layered rhythms.","sourceUrl":"https://en.wikivoyage.org/wiki/Zimbabwe","sourceTitle":"Wikivoyage — Zimbabwe"},"food":{"name":"Sadza","text":"A thick maize preparation is served with vegetable relishes or stews.","sourceUrl":"https://en.wikivoyage.org/wiki/Zimbabwe#Eat","sourceTitle":"Wikivoyage — Zimbabwe — Eat"},"photo":{"src":"data/postcards/ZWE.a3d5a263973d.jpg","alt":"Elephants crossing Zambezi River in Mana Pools National Park, Zimbabwe","width":960,"height":720,"author":"Babakathy","sourceTitle":"Zambezi-at-Mutsango.JPG","sourceUrl":"https://commons.wikimedia.org/wiki/File:Zambezi-at-Mutsango.JPG","license":"CC0","licenseUrl":"https://creativecommons.org/publicdomain/zero/1.0/deed.en","changes":"Resized."}}
